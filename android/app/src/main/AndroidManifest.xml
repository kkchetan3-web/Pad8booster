<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No INTERNET permission: PADFINITY is local-first and makes no network calls.
      The recommendation catalogue ships inside the APK.

      No QUERY_ALL_PACKAGES: we declare only what we resolve, which is what Play
      policy expects and what users deserve.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="PADFINITY"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:usesCleartextTraffic="false"
        android:hardwareAccelerated="true"
        android:largeHeap="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Deliberately NOT a HOME category: replacing com.miui.home would cost
              the HyperOS dock and 1:9 split. See KNOWN_LIMITATIONS.md §5.
            -->
        </activity>

        <activity
            android:name=".RecoveryActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="PADFINITY recovery">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="padfinity" android:host="recovery" />
            </intent-filter>
        </activity>
    </application>
</manifest>
